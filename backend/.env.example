# AI provider selection
# AI_PROVIDER: anthropic (default) | openai | openai-compatible
AI_PROVIDER=anthropic
# AI_MODEL defaults: claude-sonnet-4-6 (anthropic), gpt-4o (openai), set explicitly for openai-compatible
AI_MODEL=claude-sonnet-4-6
# Required only for openai-compatible (e.g. Vultr, Ollama, Groq)
AI_BASE_URL=
AI_API_KEY=

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI (embeddings — text-embedding-3-small, 1536 dimensions)
OPENAI_API_KEY=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
# JSON string of the downloaded service account key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Cloud Storage bucket names
GCS_BUCKET_LANCEDB=vectordb-rag-prod-lancedb
GCS_BUCKET_BOOKS=vectordb-rag-prod-books

# LanceDB — local path inside the container
LANCEDB_PATH=/data/lancedb
LANCEDB_TABLE=book_chunks

# Server
PORT=8080
NODE_ENV=development

# Stripe (Payment Links only for MVP — secret key for future webhook use)
STRIPE_SECRET_KEY=
