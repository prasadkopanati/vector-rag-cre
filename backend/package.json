{
  "name": "circleso-backend",
  "version": "1.0.0",
  "description": "Circle So backend API — AI-powered real estate Q&A",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ingest": "ts-node src/scripts/extractPdfs.ts && ts-node src/scripts/chunkText.ts && ts-node src/scripts/generateEmbeddings.ts && ts-node src/scripts/seedLanceDB.ts && ts-node src/scripts/backupLanceDB.ts",
    "seed:demo": "ts-node src/scripts/seedDemoThread.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/storage": "^7.15.0",
    "@lancedb/lancedb": "^0.14.0",
    "apache-arrow": "^17.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.3.0",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
