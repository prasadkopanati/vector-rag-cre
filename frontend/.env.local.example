# Firebase client SDK (public — safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend URL — empty string proxies through Firebase Hosting rewrites in production.
# Set to http://localhost:8080 for local development against a local backend.
NEXT_PUBLIC_API_URL=

# Stripe Payment Links — paste links from Stripe dashboard (no secret key needed)
NEXT_PUBLIC_STRIPE_FOUNDING_MEMBER_LINK=
NEXT_PUBLIC_STRIPE_ANNUAL_LINK=
